# Gift Valy — every setting the app and its scripts read (FUNNEL_LINER.md GV-14).
#
# Development: copy to .env and fill the database lines (Neon); everything
# else may stay as below.
# Server: /srv/giftvaly/shared/.env (production) and /srv/giftvaly-staging/shared/.env
# (staging), mode 600, written ON the server by DEPLOYMENT.md step 6 — every
# secret is generated there with openssl and copied by the owner into the
# password manager, never into a chat, this repository or code.
# scripts/deploy.sh refuses a server .env that breaks the rules noted below.

# ---- Database ----
# The app's connection. Server: the app role (rows only), over the local socket:
#   postgresql://giftvaly_app:<pw>@localhost/giftvaly?host=/var/run/postgresql&connection_limit=5&pool_timeout=10
#   (staging: giftvaly_staging_app … /giftvaly_staging)
# Development: Neon's pooled URL.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Migrations (`prisma migrate deploy`) and backups. Server: the OWNER role:
#   postgresql://giftvaly_owner:<pw>@localhost/giftvaly?host=/var/run/postgresql
# Development: Neon's direct URL (host without "-pooler").
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
# Shadow database for `npm run db:diff` — DEVELOPMENT ONLY, never on a server
# (deploy.sh refuses it). Prisma WIPES it on every diff, so its name must end
# in _shadow; db:diff refuses to run otherwise (CLAUDE.md rule 8).
SHADOW_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/giftvaly_shadow?sslmode=require"

# ---- Addresses (CLAUDE.md rule 9) ----
# The address PEOPLE use. Production https://dashboard.funnelliner.com,
# staging https://gv-staging.funnelliner.com.
NEXTAUTH_URL="http://localhost:3000"
# The address MACHINES use (the Steadfast webhook callback): NEXTAUTH_URL +
# /_c/giftvaly — production https://dashboard.funnelliner.com/_c/giftvaly.
# Unset = falls back to NEXTAUTH_URL, so development needs nothing.
INSTANCE_URL=""

# ---- Secrets (server: generate each one on the server) ----
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
# Encrypts the saved Steadfast API key/secret + webhook token. MUST be set on
# the server, and differ from NEXTAUTH_SECRET: unset, it falls back to
# NEXTAUTH_SECRET, so rotating that would make the saved keys unreadable.
# Keep it in the password manager — a restore needs it.
#   openssl rand -base64 32
COURIER_ENCRYPTION_KEY=""
# Bearer secret for /api/cron/* (scripts/run-job.sh reads it from this file;
# it is never written into the cron file). At least 16 characters.
#   openssl rand -hex 32
CRON_SECRET=""
# Secret Funnel Liner's admin panel sends as "Authorization: Bearer <secret>"
# to /api/platform/* (usage, state, billing, has-user). Must differ from
# CRON_SECRET. Unset = every platform route answers 401 (fails closed). The
# owner pastes it into the admin panel's client page from their own Terminal.
#   openssl rand -hex 32
PLATFORM_SECRET=""

# ---- Funnel Liner ----
# "enabled" (exactly) shows "Not your shop? Sign in with another number"
# (/go/switch) on the sign-in page — set on go-live day, when the shared
# sign-in page is live on dashboard.funnelliner.com. Anything else hides it.
SHARED_SIGNIN=""
# Funnel Liner's help number, shown on the Billing page under "How to pay"
# (GV-8). Unset = the line is hidden.
FUNNEL_LINER_HELP_PHONE=""

# ---- Files (GV-11) ----
# Uploaded images and invoice PDFs. Never inside public/ (the app refuses it),
# and on the server outside every release — deploy.sh requires exactly:
#   production  /srv/giftvaly/uploads          /srv/giftvaly/invoices
#   staging     /srv/giftvaly-staging/uploads  /srv/giftvaly-staging/invoices
# Unset = ./storage/uploads and ./storage/invoices (development).
UPLOAD_DIR=""
INVOICE_DIR=""

# ---- Backups (scripts/backup.sh, production only — GV-13) ----
# Where dumps go on the server.
BACKUP_DIR="/var/backups/giftvaly"
# The encrypted off-server copy — Antu's rclone crypt remote on Backblaze B2.
BACKUP_RCLONE_REMOTE="antu-offsite:"
# Nightly dumps kept on the server (days) and hourly ones (hours). Off the
# server, the bucket's lifecycle rules decide (DEPLOYMENT.md step 11).
BACKUP_RETENTION_DAYS="14"
BACKUP_HOURLY_RETENTION_HOURS="48"

# ---- Steadfast (optional) ----
# Override the Steadfast API base URL (default https://portal.packzy.com/api/v1)
# STEADFAST_BASE_URL=""
