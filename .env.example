# Neon Postgres — pooled connection for the app
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection for Prisma migrations (remove "-pooler" from host)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Steadfast courier integration (STEADFAST_INTEGRATION.md).
# Encryption key for the stored Steadfast API key/secret + webhook token.
# Optional — falls back to NEXTAUTH_SECRET if unset. Set a dedicated key in prod:
#   openssl rand -base64 32
COURIER_ENCRYPTION_KEY=""
# Override the Steadfast API base URL (default https://portal.packzy.com/api/v1)
# STEADFAST_BASE_URL=""
# Secret for the scheduled poller endpoint GET /api/cron/steadfast-sync
# (STEADFAST_INTEGRATION.md §3B). Vercel Cron sends it automatically as
# "Authorization: Bearer <secret>"; a VPS cron passes the same header.
#   openssl rand -hex 32
CRON_SECRET=""
