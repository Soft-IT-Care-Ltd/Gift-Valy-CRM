# Neon Postgres — pooled connection for the app
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection for Prisma migrations (remove "-pooler" from host)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Steadfast courier integration (STEADFAST_INTEGRATION.md).
# Encryption key for the stored Steadfast API key/secret + webhook token.
# Optional — falls back to NEXTAUTH_SECRET if unset. Set a dedicated key in prod:
#   openssl rand -base64 32
COURIER_ENCRYPTION_KEY=""
# Override the Steadfast API base URL (default https://portal.packzy.com/api/v1)
# STEADFAST_BASE_URL=""
# Secret for the scheduled poller endpoint GET /api/cron/steadfast-sync
# (STEADFAST_INTEGRATION.md §3B). Vercel Cron sends it automatically as
# "Authorization: Bearer <secret>"; a VPS cron passes the same header.
#   openssl rand -hex 32
CRON_SECRET=""

# Shadow database for `npm run db:diff` (development only — never on the
# server). Prisma WIPES it on every diff, so its name must end in _shadow;
# db:diff refuses to run otherwise (CLAUDE.md rule 8).
SHADOW_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/giftvaly_shadow?sslmode=require"

# ---- Funnel Liner (FUNNEL_LINER.md GV-2…GV-6) ----
# Secret Funnel Liner's admin panel sends as "Authorization: Bearer <secret>" to
# /api/platform/* (usage, state, billing, has-user). Separate from CRON_SECRET.
# Unset = every platform route answers 401 (fails closed). Generate on the
# server and paste into the admin panel's client page — never into chat:
#   openssl rand -hex 32
PLATFORM_SECRET=""
# The address MACHINES use to reach this app (the Steadfast webhook callback):
# production https://dashboard.funnelliner.com/_c/giftvaly. NEXTAUTH_URL stays
# the address PEOPLE use (https://dashboard.funnelliner.com). Unset = falls
# back to NEXTAUTH_URL, so development needs nothing.
INSTANCE_URL=""
# "enabled" (exactly) shows "Not your shop? Sign in with another number"
# (/go/switch) on the sign-in page — set once Funnel Liner's shared sign-in
# page is live on dashboard.funnelliner.com. Anything else hides it.
SHARED_SIGNIN=""
