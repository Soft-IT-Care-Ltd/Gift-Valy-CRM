// Gift Valy ERP — Prisma schema
// Phase 1: AUTH & ORG + CATALOG + CUSTOMERS & ORDERS + PAYMENTS (SPEC §14).
// Phase 2: STOCK MOVEMENTS + PURCHASES + EXPENSES (SPEC §6.3 / §9.1 / §14).
// Naming: snake_case in DB via @map/@@map. Money = Decimal(12,2) BDT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String    @map("password_hash")
  roleId             Int       @map("role_id")
  teamId             Int?      @map("team_id")
  isActive           Boolean   @default(true) @map("is_active")
  isOnboarding       Boolean   @default(false) @map("is_onboarding")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  joinedAt           DateTime? @map("joined_at") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")

  role               Role                     @relation(fields: [roleId], references: [id])
  team               Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  leaderOf           Team[]                   @relation("TeamLeader")
  overrides          UserPermissionOverride[]
  auditLogs          AuditLog[]
  salesOrders        Order[]                  @relation("SalesOrders")
  orderStatusChanges OrderStatusHistory[]     @relation("StatusChanges")
  orderEditRequests  OrderEditRequest[]       @relation("EditRequests")
  assignedLeads      Lead[]                   @relation("AssignedLeads")
  leadDailyCounts    LeadDailyCount[]         @relation("LeadDailyCounts")
  targets            Target[]                 @relation("UserTargets")
  rewards            Reward[]                 @relation("UserRewards")
  attendance         Attendance[]             @relation("UserAttendance")
  leaveRequests      LeaveRequest[]           @relation("UserLeaves")

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id  Int    @id @default(autoincrement())
  key String @unique

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId       Int     @map("user_id")
  permissionId Int     @map("permission_id")
  allow        Boolean

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_overrides")
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  leaderUserId Int?     @map("leader_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  leader  User?    @relation("TeamLeader", fields: [leaderUserId], references: [id])
  members User[]   @relation("TeamMembers")
  orders  Order[]
  leads   Lead[]
  targets Target[] @relation("TeamTargets")

  @@map("teams")
}

// ============ LEADS (SPEC §3 / §14) ============

// SPEC §3.1 Source enum. Free-text campaign name lives separately (campaignName).
enum LeadSource {
  FACEBOOK_AD
  MESSENGER
  WHATSAPP
  INSTAGRAM
  REFERRAL
  REPEAT_CUSTOMER
  OTHER
}

// SPEC §3.1 funnel statuses. CONVERTED is set by the auto-convert hook when an
// order is created from the lead (§3.2); LOST requires a lostReason.
// COMMITTED (CORRECTIONS Leads §9): customer verbally confirmed and promised
// the advance but hasn't paid — sits between NEGOTIATING and CONVERTED and
// feeds the "Committed queue" that gets chased until the payment lands.
enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  NEGOTIATING
  COMMITTED
  CONVERTED
  LOST
}

// SPEC §3.1 — required when status = LOST; drives the lost-reason breakdown (R2).
enum LostReason {
  PRICE
  TRUST
  DELIVERY_TIME
  OUT_OF_AREA
  NO_RESPONSE
  OTHER
}

// A lead logged by an SE (SPEC §3.1). whatsapp_number is the dedupe key for the
// duplicate-phone check (§3.1). interested_in is a JSON array of
// {itemType:'PRODUCT'|'PACKAGE', id, name} snapshots. The lead↔order link is the
// single unique FK orders.lead_id (Order.lead below); Lead.convertedOrder is its
// back-relation, so a lead's converted order id is derived, never duplicated.
model Lead {
  id             Int         @id @default(autoincrement())
  leadDate       DateTime    @map("lead_date") @db.Date
  source         LeadSource
  campaignName   String?     @map("campaign_name")
  customerName   String?     @map("customer_name")
  country        String?
  whatsappNumber String      @map("whatsapp_number")
  interestedIn   Json?       @map("interested_in")
  status         LeadStatus  @default(NEW)
  // CORRECTIONS Leads §9 — when the lead last entered COMMITTED; drives the
  // "time since commitment" column of the Committed queue.
  committedAt    DateTime?   @map("committed_at")
  followUpAt     DateTime?   @map("follow_up_at")
  lostReason     LostReason? @map("lost_reason")
  notes          String?
  assignedTo     Int         @map("assigned_to")
  teamId         Int?        @map("team_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdBy      Int?        @map("created_by")
  updatedBy      Int?        @map("updated_by")

  assignee       User   @relation("AssignedLeads", fields: [assignedTo], references: [id])
  team           Team?  @relation(fields: [teamId], references: [id])
  convertedOrder Order? @relation("LeadConversion")

  @@index([assignedTo, status])
  @@index([teamId, status])
  @@index([whatsappNumber])
  @@index([followUpAt])
  @@index([leadDate])
  @@map("leads")
}

// SPEC §3.1 bulk quick-entry — a daily lead count per SE/source/campaign, used
// for conversion-rate math when individual leads aren't logged. One row per
// (date, user, source, campaign) — the count is edited in place (upsert).
model LeadDailyCount {
  id           Int        @id @default(autoincrement())
  date         DateTime   @db.Date
  userId       Int        @map("user_id")
  source       LeadSource
  campaignName String?    @map("campaign_name")
  count        Int
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    Int?       @map("created_by")
  updatedBy    Int?       @map("updated_by")

  user User @relation("LeadDailyCounts", fields: [userId], references: [id])

  @@index([date])
  @@index([userId, date])
  @@map("lead_daily_counts")
}

// ============ CATALOG (SPEC §6.1 / §6.2 / §14) ============

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")

  products Product[]

  @@map("categories")
}

// CORRECTIONS Products §1 — SELLABLE products go in the order form/catalog;
// COMPONENT products (packing materials: cartons, safety boxes, gift wrap) have
// no selling price, are never sold standalone, but ARE stocked, purchased,
// damaged, and consumed by BOMs like any other product.
enum ProductType {
  SELLABLE
  COMPONENT
}

// CORRECTIONS Products §3 — the recipient's delivery zone. Shared by the
// per-product/package customer-facing delivery charges and (later, C5) the
// courier cost rate table.
enum DeliveryZone {
  INSIDE_DHAKA
  SUB_DHAKA
  OUTSIDE_DHAKA
}

model Product {
  id                Int         @id @default(autoincrement())
  sku               String      @unique
  name              String
  productType       ProductType @default(SELLABLE) @map("product_type")
  categoryId        Int         @map("category_id")
  photoUrl          String?     @map("photo_url")
  unit              String      @default("pcs") // pcs | box | set
  avgCost           Decimal     @default(0) @map("avg_cost") @db.Decimal(12, 2) // weighted avg, recomputed on purchase (Phase 2)
  sellingPrice      Decimal     @map("selling_price") @db.Decimal(12, 2) // forced 0 for COMPONENT products
  priceFloor        Decimal     @default(0) @map("price_floor") @db.Decimal(12, 2)
  lowStockThreshold Int         @default(0) @map("low_stock_threshold")
  isStockTracked    Boolean     @default(true) @map("is_stock_tracked") // false = perishable/per-order (cake, flowers)
  isActive          Boolean     @default(true) @map("is_active")
  // CORRECTIONS Products §3 — optional weight (kg) + optional customer-facing
  // delivery charge per zone (all 0 = free delivery, the usual case).
  weightKg                   Decimal? @map("weight_kg") @db.Decimal(8, 3)
  deliveryChargeInsideDhaka  Decimal  @default(0) @map("delivery_charge_inside_dhaka") @db.Decimal(12, 2)
  deliveryChargeSubDhaka     Decimal  @default(0) @map("delivery_charge_sub_dhaka") @db.Decimal(12, 2)
  deliveryChargeOutsideDhaka Decimal  @default(0) @map("delivery_charge_outside_dhaka") @db.Decimal(12, 2)
  // Caches — pure sums over stock_movements, written in the SAME transaction
  // as the movement rows (SPEC §14 integrity rule 2). stock_qty = physical
  // on-hand; reserved_qty = held by CONFIRMED orders; available = qty − reserved.
  stockQty          Int      @default(0) @map("stock_qty")
  reservedQty       Int      @default(0) @map("reserved_qty")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")

  category       Category            @relation(fields: [categoryId], references: [id])
  packageItems   PackageItem[]
  choiceOptions  PackageItemOption[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  // CORRECTIONS Products §2 — this product's own packing materials…
  components     ProductComponent[]  @relation("ProductComponents")
  // …and the reverse: which products consume THIS one as a component.
  componentOf    ProductComponent[]  @relation("ComponentUsage")

  @@map("products")
}

// CORRECTIONS Products §2 — product-level packing materials: a SELLABLE product
// consumes qty × component per unit sold (standalone or inside any package).
// Only SELLABLE products may own components and only COMPONENT products may BE
// components (enforced in the API) — that keeps this one level deep by
// construction, so the BOM explosion can never cycle through products.
model ProductComponent {
  id          Int @id @default(autoincrement())
  productId   Int @map("product_id")
  componentId Int @map("component_id")
  qty         Int

  product   Product @relation("ProductComponents", fields: [productId], references: [id], onDelete: Cascade)
  component Product @relation("ComponentUsage", fields: [componentId], references: [id])

  @@unique([productId, componentId])
  @@map("product_components")
}

// ============ STOCK MOVEMENTS (SPEC §6.3 / §14) ============

enum StockMovementType {
  IN_PURCHASE
  OUT_SALE
  RESERVE
  RELEASE_RESERVE
  IN_RETURN
  ADJUST_PLUS
  ADJUST_MINUS
}

// Immutable ledger — rows are only ever inserted, never updated or deleted
// (corrections are new ADJUST rows). qty is SIGNED by effect on availability:
//   physical types (IN_PURCHASE +, OUT_SALE −, IN_RETURN +, ADJUST_PLUS +,
//   ADJUST_MINUS −) sum to products.stock_qty;
//   RESERVE (−) / RELEASE_RESERVE (+) sum to −products.reserved_qty.
// Therefore SUM(qty) over ALL rows = available-to-sell ("current stock =
// SUM(movements)", SPEC §14). All writes go through lib/stock.ts applyMovements.
model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  qty       Int
  refTable  String?           @map("ref_table") // "orders" | "purchases" | null (manual adjust)
  refId     Int?              @map("ref_id")
  reason    String?
  at        DateTime          @default(now())
  createdBy Int?              @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, at])
  @@index([refTable, refId])
  @@map("stock_movements")
}

// ============ PURCHASES (SPEC §6.3 / §14) ============

enum PurchasePaymentStatus {
  PAID
  DUE
  PARTIAL
}

model Purchase {
  id            Int                   @id @default(autoincrement())
  supplierName  String                @map("supplier_name")
  purchaseDate  DateTime              @map("purchase_date") @db.Date
  totalAmount   Decimal               @map("total_amount") @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(PAID) @map("payment_status")
  // When the outstanding balance is due (supplier credit, SPEC §6.3). Null when
  // fully paid at purchase. Amount paid = Σ linked "Product Purchase" expenses;
  // due = total_amount − paid, recognised as expense only when cash is paid.
  dueDate       DateTime?             @map("due_date") @db.Date
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  createdBy     Int?                  @map("created_by")
  updatedBy     Int?                  @map("updated_by")

  items PurchaseItem[]

  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int     @map("purchase_id")
  productId  Int     @map("product_id")
  qty        Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ============ EXPENSES (SPEC §9.1 / §14) ============
// Phase 2 scope: the model + the auto-created purchase expense (§6.3).
// The daily expense-entry UI arrives with the Accounting module.

enum CostType {
  FIXED
  VARIABLE
}

model ExpenseCategory {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  costType CostType @map("cost_type")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id           Int      @id @default(autoincrement())
  expenseDate  DateTime @map("expense_date") @db.Date
  categoryId   Int      @map("category_id")
  amount       Decimal  @db.Decimal(12, 2)
  walletId     Int?     @map("wallet_id") // paid-from account (SPEC §9.1 / §9.3)
  campaignName String?  @map("campaign_name")
  notes        String?
  receiptUrl   String?  @map("receipt_url")
  refTable     String?  @map("ref_table") // links auto-expenses: "purchases", "shipments", "rewards"
  refId        Int?     @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  wallet   Wallet?         @relation(fields: [walletId], references: [id])

  @@index([expenseDate])
  @@index([refTable, refId])
  @@index([walletId])
  @@map("expenses")
}

model Package {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  photoUrl     String?  @map("photo_url")
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  priceFloor   Decimal  @default(0) @map("price_floor") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  // CORRECTIONS Products §3 — weight auto-sums from the BOM explosion; a
  // non-null value here is a manual override. Zone delivery charges as products.
  weightKg                   Decimal? @map("weight_kg") @db.Decimal(8, 3)
  deliveryChargeInsideDhaka  Decimal  @default(0) @map("delivery_charge_inside_dhaka") @db.Decimal(12, 2)
  deliveryChargeSubDhaka     Decimal  @default(0) @map("delivery_charge_sub_dhaka") @db.Decimal(12, 2)
  deliveryChargeOutsideDhaka Decimal  @default(0) @map("delivery_charge_outside_dhaka") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  items      PackageItem[] @relation("PackageBom")
  usedIn     PackageItem[] @relation("SubPackageUsage")
  orderItems OrderItem[]

  @@map("packages")
}

// CORRECTIONS Products §5 — a BOM line is a product, a nested sub-package, or a
// choice group ("pick 1 of: Red Teddy / Pink Teddy" × qty, options below).
enum PackageItemKind {
  PRODUCT
  PACKAGE
  CHOICE
}

// The BOM. Editing it affects future orders only — order_items freeze
// unit_cost_snapshot at PACKED (SPEC §6.2 / integrity rule 4).
// Exactly one of product_id / child_package_id / options is populated,
// according to kind (validated in the API; lib/bom.ts explodes recursively
// with cycle prevention and a nesting cap).
model PackageItem {
  id             Int             @id @default(autoincrement())
  packageId      Int             @map("package_id")
  kind           PackageItemKind @default(PRODUCT)
  productId      Int?            @map("product_id") // kind = PRODUCT
  childPackageId Int?            @map("child_package_id") // kind = PACKAGE
  choiceLabel    String?         @map("choice_label") // kind = CHOICE (e.g. "Teddy colour")
  qty            Int

  package      Package             @relation("PackageBom", fields: [packageId], references: [id], onDelete: Cascade)
  product      Product?            @relation(fields: [productId], references: [id])
  childPackage Package?            @relation("SubPackageUsage", fields: [childPackageId], references: [id])
  options      PackageItemOption[]

  @@unique([packageId, productId])
  @@unique([packageId, childPackageId])
  @@map("package_items")
}

// CORRECTIONS Products §5 — the variants of one CHOICE line. Exactly one option
// per group is flagged default (used for catalog cost/availability estimates);
// the SE's actual pick is stored on the order item (order_items.choice_selections).
model PackageItemOption {
  id            Int     @id @default(autoincrement())
  packageItemId Int     @map("package_item_id")
  productId     Int     @map("product_id")
  isDefault     Boolean @default(false) @map("is_default")

  item    PackageItem @relation(fields: [packageItemId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@unique([packageItemId, productId])
  @@map("package_item_options")
}

// ============ CUSTOMERS & ORDERS (SPEC §4 / §14) ============

// SPEC §1.3 — LEAD/FOLLOW_UP exist in the lifecycle but orders are entered at
// CONFIRMED (§4.1 E); pre-order stages live in the Leads module (Phase 3).
// DRAFT (CORRECTIONS Leads §10): a fully-detailed order saved before the
// advance arrives — no stock reserve, no invoice, excluded from sales; carries
// a temporary DRAFT-XXXX number until CONFIRM assigns the real GV number.
enum OrderStatus {
  DRAFT
  LEAD
  FOLLOW_UP
  CONFIRMED
  PACKED
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderItemType {
  PRODUCT
  PACKAGE
}

enum PaymentType {
  ADVANCE
  PARTIAL
  COD_COURIER
  POST_DELIVERY_MFS
  REFUND
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
  COURIER_COD
  OTHER
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// CORRECTIONS Orders §1 — how the customer wants the delivery timed. FIXED
// carries a date in orders.requested_delivery_date; ASAP/ANY_DAY don't.
enum DeliveryDateMode {
  ASAP
  ANY_DAY
  FIXED
}

// The probashi payer — phone_foreign is the repeat-customer lookup key (§4.1 A).
model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  phoneForeign String   @unique @map("phone_foreign")
  country      String
  fbLink       String?  @map("fb_link")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  orders    Order[]
  occasions CustomerOccasion[]

  @@map("customers")
}

// CORRECTIONS Orders §7 — the customer↔recipient occasion profile. One row per
// (customer, recipient BD phone): birthday/anniversary entered on the order
// form persist here (not just on the order), so the upcoming-occasions engine
// (C8) can pitch repeat sales. Dates are @db.Date — write via dbDate().
model CustomerOccasion {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  recipientName    String    @map("recipient_name")
  recipientPhoneBd String    @map("recipient_phone_bd")
  relation         String?
  birthday         DateTime? @db.Date
  anniversary      DateTime? @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, recipientPhoneBd])
  @@index([birthday])
  @@index([anniversary])
  @@map("customer_occasions")
}

model Order {
  id                    Int         @id @default(autoincrement())
  orderNo               String      @unique @map("order_no") // GV-YYMM-XXXX (§4.2)
  leadId                Int?        @unique @map("lead_id") // set on auto-convert from a lead (§3.2); 1:1 with Lead
  customerId            Int         @map("customer_id")
  recipientName         String      @map("recipient_name")
  recipientPhoneBd      String      @map("recipient_phone_bd") // number 2 of 2 (§1.2)
  recipientRelation     String?     @map("recipient_relation")
  deliveryAddress       String      @map("delivery_address")
  // CORRECTIONS Orders §5 — District/Thana were removed from the order form
  // (Steadfast only needs the address string). Kept as columns for legacy rows;
  // new orders store "".
  district              String      @default("")
  thana                 String      @default("")
  // CORRECTIONS Products §3 — recipient zone; drives the delivery-charge
  // auto-fill from item zone charges on the order form. Nullable: legacy
  // orders and free-delivery entries have no zone.
  deliveryZone          DeliveryZone? @map("delivery_zone")
  occasion              String?
  // CORRECTIONS Orders §1 — ASAP / Any day / Fixed date. FIXED requires
  // requested_delivery_date; the other modes keep it null.
  deliveryDateMode      DeliveryDateMode @default(ANY_DAY) @map("delivery_date_mode")
  requestedDeliveryDate DateTime?   @map("requested_delivery_date") @db.Date
  subtotal              Decimal     @db.Decimal(12, 2)
  discount              Decimal     @default(0) @db.Decimal(12, 2)
  courierChargeCustomer Decimal     @default(0) @map("courier_charge_customer") @db.Decimal(12, 2)
  totalAmount           Decimal     @map("total_amount") @db.Decimal(12, 2) // subtotal − discount + courier (§4.1 C)
  advanceAmount         Decimal     @default(0) @map("advance_amount") @db.Decimal(12, 2) // initial advance at confirmation (snapshot)
  dueAmount             Decimal     @map("due_amount") @db.Decimal(12, 2) // recomputed on every payment write (integrity rule 1)
  codAmount             Decimal     @default(0) @map("cod_amount") @db.Decimal(12, 2)
  status                OrderStatus @default(CONFIRMED)
  cancelReason          String?     @map("cancel_reason")
  // CORRECTIONS Orders §6d — 3-note system. `notes` = Order Note (internal);
  // invoice_note prints on the invoice (customer-visible); courier_note is the
  // delivery instruction sent to Steadfast as the consignment `note`.
  notes                 String?
  invoiceNote           String?     @map("invoice_note")
  courierNote           String?     @map("courier_note")
  salesExecutiveId      Int         @map("sales_executive_id")
  teamId                Int?        @map("team_id")
  // CORRECTIONS Orders §6f — soft delete (Trash). A trashed order keeps its row
  // for 30 days (restorable), is excluded from every list/report/stock query
  // (lib/db.ts auto-filter), then the cron purge deletes it permanently.
  deletedAt             DateTime?   @map("deleted_at")
  deletedBy             Int?        @map("deleted_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  createdBy             Int?        @map("created_by")
  updatedBy             Int?        @map("updated_by")

  customer       Customer             @relation(fields: [customerId], references: [id])
  salesExecutive User                 @relation("SalesOrders", fields: [salesExecutiveId], references: [id])
  team           Team?                @relation(fields: [teamId], references: [id])
  lead           Lead?                @relation("LeadConversion", fields: [leadId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  editRequests     OrderEditRequest[]
  invoices         Invoice[]
  shipment         Shipment?
  whatsappMessages WhatsAppMessage[]

  // List queries filter by scope/status/window and sort by created_at desc —
  // composite indexes keep them fast as data accumulates (SPEC-scale: years).
  @@index([status, createdAt])
  @@index([salesExecutiveId, createdAt])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([recipientPhoneBd])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id               Int           @id @default(autoincrement())
  orderId          Int           @map("order_id")
  itemType         OrderItemType @map("item_type")
  productId        Int?          @map("product_id")
  packageId        Int?          @map("package_id")
  customName       String?       @map("custom_name") // ad-hoc package lines (§4.1 C)
  qty              Int
  unitPrice        Decimal       @map("unit_price") @db.Decimal(12, 2)
  unitCostSnapshot Decimal?      @map("unit_cost_snapshot") @db.Decimal(12, 2) // frozen at PACKED (integrity rule 4, Phase 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(12, 2)
  // CORRECTIONS Products §5 — the SE's picks for the package's choice groups:
  // [{ groupId, label, productId, name }] snapshotted at order time (groupId =
  // package_items.id of the CHOICE line, unique across the whole nested tree).
  // Stock reserve/deduct and cost snapshots follow the chosen variant.
  choiceSelections Json?         @map("choice_selections")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  @@map("order_items")
}

// Every status change timestamped → SLA reports (§4.2).
model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status") // null = order creation
  toStatus   OrderStatus  @map("to_status")
  byUser     Int          @map("by_user")
  at         DateTime     @default(now())
  note       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation("StatusChanges", fields: [byUser], references: [id])

  @@map("order_status_history")
}

// SPEC §8 / §14 — the company's receiving accounts (bKash/Nagad/Rocket agent
// numbers, bank accounts, cash box). Every payment records which wallet the
// money landed in; expenses record which wallet they were paid from. Per-wallet
// running balance = collections in − refunds/expenses out (SPEC §9.3). The
// account list is maintained by Admin/Accounts (SPEC §8).
enum WalletType {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
}

model Wallet {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  type      WalletType
  accountNo String?    @map("account_no")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  createdBy Int?       @map("created_by")
  updatedBy Int?       @map("updated_by")

  payments Payment[]
  expenses Expense[]

  @@map("wallets")
}

// SPEC §8 — multiple payments per order; transaction_id unique blocks
// double-entry of the same bKash/Nagad txn (integrity rule 3).
// REFUND amounts are stored positive and added back to due (integrity rule 1).
model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  paymentDate     DateTime      @default(now()) @map("payment_date")
  type            PaymentType
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  transactionId   String?       @unique @map("transaction_id")
  senderNumber    String?       @map("sender_number")
  screenshotUrl   String?       @map("screenshot_url")
  walletId        Int?          @map("wallet_id") // receiving account (SPEC §8); nullable so historic/unattributed COD rows stay valid
  isVerified      Boolean       @default(false) @map("is_verified") // Accounts verifies against the wallet statement (SPEC §8)
  verifiedBy      Int?          @map("verified_by")
  // Rejection (SPEC §8) — Accounts checked and the money never arrived (fake
  // txn / wrong amount). A rejected payment is excluded from due & collections,
  // so recording it never falsely settles an order. Mutually exclusive with
  // is_verified (enforced in the verify route).
  isRejected      Boolean       @default(false) @map("is_rejected")
  rejectionReason String?       @map("rejection_reason")
  rejectedBy      Int?          @map("rejected_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdBy       Int?          @map("created_by")
  updatedBy       Int?          @map("updated_by")

  // Cascade: the 30-day trash purge (CORRECTIONS Orders §6f) hard-deletes the
  // order row; its payments go with it (the order was already excluded from
  // collections/wallets the moment it was trashed).
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id])

  @@index([orderId])
  @@index([walletId])
  @@index([paymentDate])
  @@map("payments")
}

// SPEC §4.2 — after the edit window, SE edits go through TL/Manager approval.
// changes_json holds the proposed order payload; applied verbatim on approval.
model OrderEditRequest {
  id          Int               @id @default(autoincrement())
  orderId     Int               @map("order_id")
  requestedBy Int               @map("requested_by")
  changesJson Json              @map("changes_json")
  reason      String?
  status      EditRequestStatus @default(PENDING)
  reviewedBy  Int?              @map("reviewed_by")
  reviewedAt  DateTime?         @map("reviewed_at")
  reviewNote  String?           @map("review_note")
  createdAt   DateTime          @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester User  @relation("EditRequests", fields: [requestedBy], references: [id])

  @@index([status])
  @@map("order_edit_requests")
}

// SPEC §5 / §14 — one row per generated invoice PDF. An approved edit
// regenerates as version N+1; older versions and their files are kept.
// pdf_url is a path under storage/ (NOT public/) — invoices carry customer
// PII, so files are served only through the authenticated invoice API.
model Invoice {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  invoiceNo   String   @map("invoice_no") // = order_no (§5)
  version     Int
  pdfUrl      String   @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy Int?     @map("generated_by")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  whatsappMessages WhatsAppMessage[]

  @@unique([orderId, version])
  @@map("invoices")
}

// ============ WHATSAPP INVOICE SEND (SPEC §5 / §16 Phase 4) ============

// Singleton row (id=1 by convention) holding the Meta WhatsApp Cloud API
// connection. The access token is encrypted at rest (lib/crypto, same scheme
// as courier_integrations); phone_number_id is not a secret. auto_send_invoice
// controls whether a freshly generated invoice is pushed to the customer's
// WhatsApp automatically (order confirm / approved edit).
model WhatsAppIntegration {
  id                   Int       @id @default(autoincrement())
  phoneNumberId        String?   @map("phone_number_id")
  accessTokenEncrypted String?   @map("access_token_encrypted")
  isEnabled            Boolean   @default(false) @map("is_enabled")
  autoSendInvoice      Boolean   @default(true) @map("auto_send_invoice")
  connectedAt          DateTime? @map("connected_at")
  lastSentAt           DateTime? @map("last_sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_integrations")
}

enum WhatsAppTrigger {
  AUTO_CONFIRM // invoice generated when the order was confirmed
  AUTO_EDIT // invoice regenerated after an approved edit
  MANUAL // user pressed "Send via WhatsApp" on the order page
}

enum WhatsAppSendStatus {
  SENT
  FAILED
}

// One row per send attempt (successful or not) — the order page shows the
// latest, the settings page shows a recent log. invoice_id goes null if that
// invoice version's row is ever removed; the order link is the durable one.
model WhatsAppMessage {
  id          Int                @id @default(autoincrement())
  orderId     Int                @map("order_id")
  invoiceId   Int?               @map("invoice_id")
  toPhone     String             @map("to_phone")
  trigger     WhatsAppTrigger
  status      WhatsAppSendStatus
  waMessageId String?            @map("wa_message_id") // Graph API message id on success
  error       String?
  sentBy      Int?               @map("sent_by") // null = automatic send
  createdAt   DateTime           @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

// ============ CURRENCY RATES (SPEC §5 — customer-currency display) ============

// Admin-maintained conversion table for the OPTIONAL customer-currency display
// on invoices (SPEC §5). bdt_per_unit = ৳ per 1 unit of the currency; countries
// lists customer countries (matched case-insensitively against
// customers.country) that price in this currency. Display-only — every stored
// amount stays BDT; the invoice prints an "approx." line at the current rate.
model CurrencyRate {
  id         Int      @id @default(autoincrement())
  code       String   @unique // ISO 4217 (SAR, AED, USD…)
  name       String
  symbol     String? // optional display symbol (﷼, د.إ, $…) — code is used when absent
  bdtPerUnit Decimal  @map("bdt_per_unit") @db.Decimal(12, 4)
  countries  String[] @default([])
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  Int?     @map("updated_by")

  @@map("currency_rates")
}

// ============ COURIER & DELIVERY (SPEC §7 / §14) ============

// A courier company (Steadfast, Pathao, RedX, Sundarban…). cod_fee_percent is
// the % the courier deducts when it remits collected COD — auto-recorded as an
// expense at reconciliation (SPEC §7 / §9.1). The schema stays multi-courier
// (CORRECTIONS Courier §2) even though the UI only exposes Steadfast for now.
model Courier {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  contact       String?
  codFeePercent Decimal  @default(0) @map("cod_fee_percent") @db.Decimal(5, 2)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     Int?     @map("created_by")
  updatedBy     Int?     @map("updated_by")

  zoneRates CourierZoneRate[]
  shipments Shipment[]

  @@map("couriers")
}

// CORRECTIONS Courier §1 — what WE pay the courier, by recipient zone: a base
// rate + a per-kg rate for each of the 3 delivery zones. Replaced the old
// per-district charge table. Drives the courier cost ESTIMATE at handover
// (base + per_kg × weight); the webhook's actual delivery_charge overrides it.
model CourierZoneRate {
  id        Int          @id @default(autoincrement())
  courierId Int          @map("courier_id")
  zone      DeliveryZone
  baseRate  Decimal      @default(0) @map("base_rate") @db.Decimal(12, 2)
  perKgRate Decimal      @default(0) @map("per_kg_rate") @db.Decimal(12, 2)

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([courierId, zone])
  @@map("courier_zone_rates")
}

// SPEC §7 — the courier-stage statuses, mirroring the OrderStatus courier
// stages. A shipment's status drives the order's status (lib/courier.ts).
enum ShipmentStatus {
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// One shipment per order (SPEC §7). Created at courier handover (moves the order
// PACKED → HANDED_TO_COURIER); status updates sync the order status. COD flags
// track reconciliation (§7); return flags track the Admin-approved stock restore
// (§1.3). courier_cost_actual is the real amount paid to the courier incl. COD
// fee — a COST used by per-order P&L (§9.2), stripped from cost-blind roles.
model Shipment {
  id                    Int            @id @default(autoincrement())
  orderId               Int            @unique @map("order_id")
  courierId             Int            @map("courier_id")
  trackingNo            String?        @map("tracking_no")
  handoverDate          DateTime       @map("handover_date") @db.Date
  codAmount             Decimal        @default(0) @map("cod_amount") @db.Decimal(12, 2)
  expectedDelivery      DateTime?      @map("expected_delivery") @db.Date
  status                ShipmentStatus @default(HANDED_TO_COURIER)
  deliveredAt           DateTime?      @map("delivered_at")
  returnedAt            DateTime?      @map("returned_at")
  courierCostActual     Decimal?       @map("courier_cost_actual") @db.Decimal(12, 2)
  // COD reconciliation (§7): received flag + link to the auto-created fee expense.
  codReceived           Boolean        @default(false) @map("cod_received")
  codReceivedAt         DateTime?      @map("cod_received_at")
  codFeeExpenseId       Int?           @map("cod_fee_expense_id")
  // Return flow (§1.3): Admin approval gates the stock restore + return charge.
  returnApproved        Boolean        @default(false) @map("return_approved")
  returnApprovedAt      DateTime?      @map("return_approved_at")
  returnApprovedBy      Int?           @map("return_approved_by")
  returnCharge          Decimal?       @map("return_charge") @db.Decimal(12, 2)
  returnChargeExpenseId Int?           @map("return_charge_expense_id")
  // Steadfast API integration (STEADFAST_INTEGRATION.md §4). All nullable/default
  // so manual (non-API) shipments are unaffected. consignment_id is the Steadfast
  // side id used to correlate webhook/poll updates back to this shipment;
  // steadfast_status is the raw courier status (audit); on_hold / needs_attention
  // are operator flags surfaced in the courier report; last_polled_at gates the
  // polling fallback (§3B).
  consignmentId         BigInt?        @unique @map("consignment_id")
  steadfastStatus       String?        @map("steadfast_status")
  onHold                Boolean        @default(false) @map("on_hold")
  needsAttention        Boolean        @default(false) @map("needs_attention")
  lastPolledAt          DateTime?      @map("last_polled_at")
  // CORRECTIONS Courier §1 + Orders §6l — zone + weight courier costing and the
  // Steadfast-reported figures. delivery_zone/weight_kg are OUR handover inputs
  // (weight pre-filled from the BOM item sum, editable); courier_cost_estimated
  // = zone base + per-kg × weight. steadfast_weight_kg / courier_cost_actual are
  // what Steadfast reports (webhook/API/tracking page) — P&L uses actual when
  // present, else the estimate. tracking_url is the public tracking link
  // (discovered from the raw create response, else built from tracking_code);
  // tracking_page_checked_at caches the gentle tracking-page fetch.
  deliveryZone          DeliveryZone?  @map("delivery_zone")
  weightKg              Decimal?       @map("weight_kg") @db.Decimal(8, 3)
  courierCostEstimated  Decimal?       @map("courier_cost_estimated") @db.Decimal(12, 2)
  steadfastWeightKg     Decimal?       @map("steadfast_weight_kg") @db.Decimal(8, 3)
  trackingUrl           String?        @map("tracking_url")
  trackingPageCheckedAt DateTime?      @map("tracking_page_checked_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  createdBy             Int?           @map("created_by")
  updatedBy             Int?           @map("updated_by")

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        Courier                 @relation(fields: [courierId], references: [id])
  statusLogs     ShipmentStatusLog[]
  trackingEvents ShipmentTrackingEvent[]

  @@index([status])
  @@index([courierId])
  @@map("shipments")
}

// ============ STEADFAST COURIER INTEGRATION (STEADFAST_INTEGRATION.md §4) ============

// Where a raw status update came from: the real-time webhook (primary), the
// polling fallback (§3A / §3B), or a direct API response we made ourselves
// (consignment creation — logged in full so tracking-link/charge/weight fields
// can be discovered, CORRECTIONS Orders §6l). Webhook/poll go through the SAME
// status-update code path.
enum StatusLogSource {
  WEBHOOK
  POLL
  API
}

// Immutable audit trail of every raw status payload Steadfast sends us, via
// webhook or poll (§3A step 4 / §3B step 4). shipment_id is nullable so a
// payload for an unknown consignment is still logged (§3A step 1).
model ShipmentStatusLog {
  id         Int             @id @default(autoincrement())
  shipmentId Int?            @map("shipment_id")
  rawPayload Json            @map("raw_payload")
  rawStatus  String?         @map("raw_status")
  source     StatusLogSource
  receivedAt DateTime        @default(now()) @map("received_at")

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@map("shipment_status_logs")
}

// Non-status tracking messages (§3A payload 2, notification_type=tracking_update)
// rendered as a timeline on the order/shipment detail page.
model ShipmentTrackingEvent {
  id         Int      @id @default(autoincrement())
  shipmentId Int      @map("shipment_id")
  message    String
  eventAt    DateTime @map("event_at")
  source     String // "WEBHOOK" | "POLL"
  createdAt  DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_tracking_events")
}

// One integration currently: Steadfast. Keys are encrypted at rest (lib/crypto.ts)
// and only ever used server-side (§5). webhook_token_encrypted authenticates
// inbound webhooks (Bearer). Timestamps give the Settings page health visibility.
enum CourierIntegrationType {
  STEADFAST
}

model CourierIntegration {
  id                    Int                    @id @default(autoincrement())
  courier               CourierIntegrationType @unique
  apiKeyEncrypted       String?                @map("api_key_encrypted")
  secretKeyEncrypted    String?                @map("secret_key_encrypted")
  webhookTokenEncrypted String?                @map("webhook_token_encrypted")
  isEnabled             Boolean                @default(false) @map("is_enabled")
  pollingMinutes        Int                    @default(60) @map("polling_minutes")
  connectedAt           DateTime?              @map("connected_at")
  lastSyncAt            DateTime?              @map("last_sync_at")
  lastWebhookAt         DateTime?              @map("last_webhook_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("courier_integrations")
}

// SPEC §14 — key/value settings (edit-window minutes, packaging cost, …).
model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  at         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============ TARGETS & REWARDS (SPEC §10 / §14) ============

// A monthly target is set for either a single user (SE/TL) or a whole team.
enum TargetScope {
  USER
  TEAM
}

// SPEC §10 — target order count and/or sales value (৳), per SE and per Team, per
// month. `month` is the first day of the calendar month (Asia/Dhaka). Either
// targetOrders or targetAmount (or both) may be set. `isConfidential` marks a
// user's own target (a TL's) as visible to Admin + that user only (§10).
model Target {
  id             Int         @id @default(autoincrement())
  month          DateTime    @db.Date
  scope          TargetScope
  userId         Int?        @map("user_id")
  teamId         Int?        @map("team_id")
  targetOrders   Int?        @map("target_orders")
  targetAmount   Decimal?    @map("target_amount") @db.Decimal(12, 2)
  isConfidential Boolean     @default(false) @map("is_confidential")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdBy      Int?        @map("created_by")
  updatedBy      Int?        @map("updated_by")

  user User? @relation("UserTargets", fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation("TeamTargets", fields: [teamId], references: [id], onDelete: Cascade)

  // One target per subject per month. userId/teamId are mutually exclusive by
  // scope; Postgres treats NULLs as distinct so the null side never collides —
  // (month,userId) guards USER rows, (month,teamId) guards TEAM rows.
  @@unique([month, userId])
  @@unique([month, teamId])
  @@index([month])
  @@map("targets")
}

// SPEC §10 — reward rule table. ACHIEVEMENT rules pay when a user's monthly
// achievement % (against their target) reaches minAchievementPercent (e.g.
// 100% → ৳3,000, 120% → ৳6,000). TOP_SELLER rules pay the month's top seller(s)
// by sales value.
enum RewardRuleType {
  ACHIEVEMENT
  TOP_SELLER
}

model RewardRule {
  id                    Int            @id @default(autoincrement())
  name                  String         @unique
  type                  RewardRuleType @default(ACHIEVEMENT)
  minAchievementPercent Decimal?       @map("min_achievement_percent") @db.Decimal(6, 2)
  rewardAmount          Decimal        @map("reward_amount") @db.Decimal(12, 2)
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  createdBy             Int?           @map("created_by")
  updatedBy             Int?           @map("updated_by")

  rewards Reward[]

  @@map("reward_rules")
}

// SPEC §10 — a computed reward for a user/month/rule. Month-close computation
// creates PENDING rows; Admin approval flips to APPROVED and books the expense
// (category "Reward/Bonus", ref → this row); PAID marks it disbursed. The set of
// a user's rewards over months is their profile reward history.
enum RewardStatus {
  PENDING
  APPROVED
  PAID
}

model Reward {
  id                 Int          @id @default(autoincrement())
  userId             Int          @map("user_id")
  month              DateTime     @db.Date
  ruleId             Int          @map("rule_id")
  amount             Decimal      @db.Decimal(12, 2)
  achievementPercent Decimal?     @map("achievement_percent") @db.Decimal(6, 2)
  status             RewardStatus @default(PENDING)
  approvedBy         Int?         @map("approved_by")
  approvedAt         DateTime?    @map("approved_at")
  expenseId          Int?         @unique @map("expense_id") // set when APPROVED books the expense
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  createdBy          Int?         @map("created_by")
  updatedBy          Int?         @map("updated_by")

  user User       @relation("UserRewards", fields: [userId], references: [id])
  rule RewardRule @relation(fields: [ruleId], references: [id])

  // Idempotent recompute: at most one reward per user, month and rule.
  @@unique([userId, month, ruleId])
  @@index([month])
  @@index([userId])
  @@map("rewards")
}

// ============ ATTENDANCE & LEAVE (SPEC §11 / §14) ============

// SPEC §11 — a day's attendance for one employee. LATE / HALF_DAY are auto-set
// from the check-in time against the office-hours settings; PRESENT is on time.
// ABSENT is never stored — it is derived in reports for a workday with no row
// and no approved leave (so no nightly job is needed). LEAVE marks a day the
// employee is out on an approved leave.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  LEAVE
}

// SPEC §11 — one row per employee per calendar day (Asia/Dhaka). `date` is that
// day stored as UTC-midnight so the @db.Date column reads back the same calendar
// day (mirrors the reward/expense date convention). Timestamps are server-side.
model Attendance {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  date       DateTime         @db.Date
  checkInAt  DateTime?        @map("check_in_at")
  checkOutAt DateTime?        @map("check_out_at")
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  createdBy  Int?             @map("created_by")
  updatedBy  Int?             @map("updated_by")

  user User @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)

  // One attendance row per user per day.
  @@unique([userId, date])
  @@index([date])
  @@map("attendance")
}

// SPEC §11 — simple leave request + approval flow. PENDING until a manager
// (attendance.view_all) approves or rejects. An APPROVED request marks its
// [fromDate, toDate] span as LEAVE in the monthly sheet.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  fromDate   DateTime    @map("from_date") @db.Date
  toDate     DateTime    @map("to_date") @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy Int?        @map("approved_by")
  approvedAt DateTime?   @map("approved_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  createdBy  Int?        @map("created_by")
  updatedBy  Int?        @map("updated_by")

  user User @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}
