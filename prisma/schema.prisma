// Gift Valy ERP — Prisma schema
// Phase 1: AUTH & ORG + CATALOG + CUSTOMERS & ORDERS + PAYMENTS (SPEC §14).
// Phase 2: STOCK MOVEMENTS + PURCHASES + EXPENSES (SPEC §6.3 / §9.1 / §14).
// Naming: snake_case in DB via @map/@@map. Money = Decimal(12,2) BDT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String    @map("password_hash")
  roleId             Int       @map("role_id")
  teamId             Int?      @map("team_id")
  isActive           Boolean   @default(true) @map("is_active")
  isOnboarding       Boolean   @default(false) @map("is_onboarding")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  joinedAt           DateTime? @map("joined_at") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")

  role        Role                     @relation(fields: [roleId], references: [id])
  team        Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  leaderOf    Team[]                   @relation("TeamLeader")
  overrides   UserPermissionOverride[]
  auditLogs   AuditLog[]
  salesOrders        Order[]              @relation("SalesOrders")
  orderStatusChanges OrderStatusHistory[] @relation("StatusChanges")
  orderEditRequests  OrderEditRequest[]   @relation("EditRequests")

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id  Int    @id @default(autoincrement())
  key String @unique

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId       Int     @map("user_id")
  permissionId Int     @map("permission_id")
  allow        Boolean

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_overrides")
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  leaderUserId Int?     @map("leader_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  leader  User?   @relation("TeamLeader", fields: [leaderUserId], references: [id])
  members User[]  @relation("TeamMembers")
  orders  Order[]

  @@map("teams")
}

// ============ CATALOG (SPEC §6.1 / §6.2 / §14) ============

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")

  products Product[]

  @@map("categories")
}

model Product {
  id                Int      @id @default(autoincrement())
  sku               String   @unique
  name              String
  categoryId        Int      @map("category_id")
  photoUrl          String?  @map("photo_url")
  unit              String   @default("pcs") // pcs | box | set
  avgCost           Decimal  @default(0) @map("avg_cost") @db.Decimal(12, 2) // weighted avg, recomputed on purchase (Phase 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(12, 2)
  priceFloor        Decimal  @default(0) @map("price_floor") @db.Decimal(12, 2)
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  isStockTracked    Boolean  @default(true) @map("is_stock_tracked") // false = perishable/per-order (cake, flowers)
  isActive          Boolean  @default(true) @map("is_active")
  // Caches — pure sums over stock_movements, written in the SAME transaction
  // as the movement rows (SPEC §14 integrity rule 2). stock_qty = physical
  // on-hand; reserved_qty = held by CONFIRMED orders; available = qty − reserved.
  stockQty          Int      @default(0) @map("stock_qty")
  reservedQty       Int      @default(0) @map("reserved_qty")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")

  category       Category        @relation(fields: [categoryId], references: [id])
  packageItems   PackageItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@map("products")
}

// ============ STOCK MOVEMENTS (SPEC §6.3 / §14) ============

enum StockMovementType {
  IN_PURCHASE
  OUT_SALE
  RESERVE
  RELEASE_RESERVE
  IN_RETURN
  ADJUST_PLUS
  ADJUST_MINUS
}

// Immutable ledger — rows are only ever inserted, never updated or deleted
// (corrections are new ADJUST rows). qty is SIGNED by effect on availability:
//   physical types (IN_PURCHASE +, OUT_SALE −, IN_RETURN +, ADJUST_PLUS +,
//   ADJUST_MINUS −) sum to products.stock_qty;
//   RESERVE (−) / RELEASE_RESERVE (+) sum to −products.reserved_qty.
// Therefore SUM(qty) over ALL rows = available-to-sell ("current stock =
// SUM(movements)", SPEC §14). All writes go through lib/stock.ts applyMovements.
model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  qty       Int
  refTable  String?           @map("ref_table") // "orders" | "purchases" | null (manual adjust)
  refId     Int?              @map("ref_id")
  reason    String?
  at        DateTime          @default(now())
  createdBy Int?              @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, at])
  @@index([refTable, refId])
  @@map("stock_movements")
}

// ============ PURCHASES (SPEC §6.3 / §14) ============

enum PurchasePaymentStatus {
  PAID
  DUE
  PARTIAL
}

model Purchase {
  id            Int                   @id @default(autoincrement())
  supplierName  String                @map("supplier_name")
  purchaseDate  DateTime              @map("purchase_date") @db.Date
  totalAmount   Decimal               @map("total_amount") @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(PAID) @map("payment_status")
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  createdBy     Int?                  @map("created_by")
  updatedBy     Int?                  @map("updated_by")

  items PurchaseItem[]

  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int     @map("purchase_id")
  productId  Int     @map("product_id")
  qty        Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ============ EXPENSES (SPEC §9.1 / §14) ============
// Phase 2 scope: the model + the auto-created purchase expense (§6.3).
// The daily expense-entry UI arrives with the Accounting module.

enum CostType {
  FIXED
  VARIABLE
}

model ExpenseCategory {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  costType CostType @map("cost_type")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id           Int      @id @default(autoincrement())
  expenseDate  DateTime @map("expense_date") @db.Date
  categoryId   Int      @map("category_id")
  amount       Decimal  @db.Decimal(12, 2)
  walletId     Int?     @map("wallet_id") // FK once wallets land (Phase 2 money module)
  campaignName String?  @map("campaign_name")
  notes        String?
  receiptUrl   String?  @map("receipt_url")
  refTable     String?  @map("ref_table") // links auto-expenses: "purchases", "shipments", "rewards"
  refId        Int?     @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([expenseDate])
  @@index([refTable, refId])
  @@map("expenses")
}

model Package {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  photoUrl     String?  @map("photo_url")
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  priceFloor   Decimal  @default(0) @map("price_floor") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  items      PackageItem[]
  orderItems OrderItem[]

  @@map("packages")
}

// The BOM. Editing it affects future orders only — order_items freeze
// unit_cost_snapshot at PACKED (SPEC §6.2 / integrity rule 4).
model PackageItem {
  id        Int @id @default(autoincrement())
  packageId Int @map("package_id")
  productId Int @map("product_id")
  qty       Int

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([packageId, productId])
  @@map("package_items")
}

// ============ CUSTOMERS & ORDERS (SPEC §4 / §14) ============

// SPEC §1.3 — LEAD/FOLLOW_UP exist in the lifecycle but orders are entered at
// CONFIRMED (§4.1 E); pre-order stages live in the Leads module (Phase 3).
enum OrderStatus {
  LEAD
  FOLLOW_UP
  CONFIRMED
  PACKED
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderItemType {
  PRODUCT
  PACKAGE
}

enum PaymentType {
  ADVANCE
  PARTIAL
  COD_COURIER
  POST_DELIVERY_MFS
  REFUND
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
  COURIER_COD
  OTHER
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// The probashi payer — phone_foreign is the repeat-customer lookup key (§4.1 A).
model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  phoneForeign String   @unique @map("phone_foreign")
  country      String
  fbLink       String?  @map("fb_link")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  orders Order[]

  @@map("customers")
}

model Order {
  id                    Int         @id @default(autoincrement())
  orderNo               String      @unique @map("order_no") // GV-YYMM-XXXX (§4.2)
  leadId                Int?        @map("lead_id") // FK once Leads module lands (Phase 3)
  customerId            Int         @map("customer_id")
  recipientName         String      @map("recipient_name")
  recipientPhoneBd      String      @map("recipient_phone_bd") // number 2 of 2 (§1.2)
  recipientRelation     String?     @map("recipient_relation")
  deliveryAddress       String      @map("delivery_address")
  district              String
  thana                 String
  occasion              String?
  requestedDeliveryDate DateTime?   @map("requested_delivery_date") @db.Date
  subtotal              Decimal     @db.Decimal(12, 2)
  discount              Decimal     @default(0) @db.Decimal(12, 2)
  courierChargeCustomer Decimal     @default(0) @map("courier_charge_customer") @db.Decimal(12, 2)
  totalAmount           Decimal     @map("total_amount") @db.Decimal(12, 2) // subtotal − discount + courier (§4.1 C)
  advanceAmount         Decimal     @default(0) @map("advance_amount") @db.Decimal(12, 2) // initial advance at confirmation (snapshot)
  dueAmount             Decimal     @map("due_amount") @db.Decimal(12, 2) // recomputed on every payment write (integrity rule 1)
  codAmount             Decimal     @default(0) @map("cod_amount") @db.Decimal(12, 2)
  status                OrderStatus @default(CONFIRMED)
  cancelReason          String?     @map("cancel_reason")
  notes                 String?
  salesExecutiveId      Int         @map("sales_executive_id")
  teamId                Int?        @map("team_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  createdBy             Int?        @map("created_by")
  updatedBy             Int?        @map("updated_by")

  customer       Customer             @relation(fields: [customerId], references: [id])
  salesExecutive User                 @relation("SalesOrders", fields: [salesExecutiveId], references: [id])
  team           Team?                @relation(fields: [teamId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  editRequests   OrderEditRequest[]
  invoices       Invoice[]
  shipment       Shipment?

  // List queries filter by scope/status/window and sort by created_at desc —
  // composite indexes keep them fast as data accumulates (SPEC-scale: years).
  @@index([status, createdAt])
  @@index([salesExecutiveId, createdAt])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([recipientPhoneBd])
  @@map("orders")
}

model OrderItem {
  id               Int           @id @default(autoincrement())
  orderId          Int           @map("order_id")
  itemType         OrderItemType @map("item_type")
  productId        Int?          @map("product_id")
  packageId        Int?          @map("package_id")
  customName       String?       @map("custom_name") // ad-hoc package lines (§4.1 C)
  qty              Int
  unitPrice        Decimal       @map("unit_price") @db.Decimal(12, 2)
  unitCostSnapshot Decimal?      @map("unit_cost_snapshot") @db.Decimal(12, 2) // frozen at PACKED (integrity rule 4, Phase 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  @@map("order_items")
}

// Every status change timestamped → SLA reports (§4.2).
model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status") // null = order creation
  toStatus   OrderStatus  @map("to_status")
  byUser     Int          @map("by_user")
  at         DateTime     @default(now())
  note       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation("StatusChanges", fields: [byUser], references: [id])

  @@map("order_status_history")
}

// SPEC §8 — multiple payments per order; transaction_id unique blocks
// double-entry of the same bKash/Nagad txn (integrity rule 3).
// REFUND amounts are stored positive and added back to due (integrity rule 1).
model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @map("order_id")
  paymentDate   DateTime      @default(now()) @map("payment_date")
  type          PaymentType
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String?       @unique @map("transaction_id")
  senderNumber  String?       @map("sender_number")
  screenshotUrl String?       @map("screenshot_url")
  walletId      Int?          @map("wallet_id") // FK once wallets land (Phase 2)
  isVerified    Boolean       @default(false) @map("is_verified") // Accounts verification (Phase 2)
  verifiedBy    Int?          @map("verified_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     Int?          @map("created_by")
  updatedBy     Int?          @map("updated_by")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// SPEC §4.2 — after the edit window, SE edits go through TL/Manager approval.
// changes_json holds the proposed order payload; applied verbatim on approval.
model OrderEditRequest {
  id          Int               @id @default(autoincrement())
  orderId     Int               @map("order_id")
  requestedBy Int               @map("requested_by")
  changesJson Json              @map("changes_json")
  reason      String?
  status      EditRequestStatus @default(PENDING)
  reviewedBy  Int?              @map("reviewed_by")
  reviewedAt  DateTime?         @map("reviewed_at")
  reviewNote  String?           @map("review_note")
  createdAt   DateTime          @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester User  @relation("EditRequests", fields: [requestedBy], references: [id])

  @@index([status])
  @@map("order_edit_requests")
}

// SPEC §5 / §14 — one row per generated invoice PDF. An approved edit
// regenerates as version N+1; older versions and their files are kept.
// pdf_url is a path under storage/ (NOT public/) — invoices carry customer
// PII, so files are served only through the authenticated invoice API.
model Invoice {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  invoiceNo   String   @map("invoice_no") // = order_no (§5)
  version     Int
  pdfUrl      String   @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy Int?     @map("generated_by")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@map("invoices")
}

// ============ COURIER & DELIVERY (SPEC §7 / §14) ============

// A courier company (Steadfast, Pathao, RedX, Sundarban…). cod_fee_percent is
// the % the courier deducts when it remits collected COD — auto-recorded as an
// expense at reconciliation (SPEC §7 / §9.1). Per-district charges live in
// courier_zone_charges (drives the district-based courier charge on orders, §4.1 B).
model Courier {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  contact       String?
  codFeePercent Decimal  @default(0) @map("cod_fee_percent") @db.Decimal(5, 2)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     Int?     @map("created_by")
  updatedBy     Int?     @map("updated_by")

  zoneCharges CourierZoneCharge[]
  shipments   Shipment[]

  @@map("couriers")
}

// Per-district delivery charge for a courier (SPEC §7 / §14). Replaced as a set
// when a courier's zones are edited (like package BOM items).
model CourierZoneCharge {
  id        Int     @id @default(autoincrement())
  courierId Int     @map("courier_id")
  district  String
  charge    Decimal @db.Decimal(12, 2)

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([courierId, district])
  @@map("courier_zone_charges")
}

// SPEC §7 — the courier-stage statuses, mirroring the OrderStatus courier
// stages. A shipment's status drives the order's status (lib/courier.ts).
enum ShipmentStatus {
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// One shipment per order (SPEC §7). Created at courier handover (moves the order
// PACKED → HANDED_TO_COURIER); status updates sync the order status. COD flags
// track reconciliation (§7); return flags track the Admin-approved stock restore
// (§1.3). courier_cost_actual is the real amount paid to the courier incl. COD
// fee — a COST used by per-order P&L (§9.2), stripped from cost-blind roles.
model Shipment {
  id                    Int            @id @default(autoincrement())
  orderId               Int            @unique @map("order_id")
  courierId             Int            @map("courier_id")
  trackingNo            String?        @map("tracking_no")
  handoverDate          DateTime       @map("handover_date") @db.Date
  codAmount             Decimal        @default(0) @map("cod_amount") @db.Decimal(12, 2)
  expectedDelivery      DateTime?      @map("expected_delivery") @db.Date
  status                ShipmentStatus @default(HANDED_TO_COURIER)
  deliveredAt           DateTime?      @map("delivered_at")
  returnedAt            DateTime?      @map("returned_at")
  courierCostActual     Decimal?       @map("courier_cost_actual") @db.Decimal(12, 2)
  // COD reconciliation (§7): received flag + link to the auto-created fee expense.
  codReceived           Boolean        @default(false) @map("cod_received")
  codReceivedAt         DateTime?      @map("cod_received_at")
  codFeeExpenseId       Int?           @map("cod_fee_expense_id")
  // Return flow (§1.3): Admin approval gates the stock restore + return charge.
  returnApproved        Boolean        @default(false) @map("return_approved")
  returnApprovedAt      DateTime?      @map("return_approved_at")
  returnApprovedBy      Int?           @map("return_approved_by")
  returnCharge          Decimal?       @map("return_charge") @db.Decimal(12, 2)
  returnChargeExpenseId Int?           @map("return_charge_expense_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  createdBy             Int?           @map("created_by")
  updatedBy             Int?           @map("updated_by")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier @relation(fields: [courierId], references: [id])

  @@index([status])
  @@index([courierId])
  @@map("shipments")
}

// SPEC §14 — key/value settings (edit-window minutes, packaging cost, …).
model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  at         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
