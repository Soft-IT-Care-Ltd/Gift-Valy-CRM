// Gift Valy ERP — Prisma schema
// Phase 1: AUTH & ORG + CATALOG + CUSTOMERS & ORDERS + PAYMENTS (SPEC §14).
// Phase 2: STOCK MOVEMENTS + PURCHASES + EXPENSES (SPEC §6.3 / §9.1 / §14).
// Naming: snake_case in DB via @map/@@map. Money = Decimal(12,2) BDT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String    @map("password_hash")
  roleId             Int       @map("role_id")
  teamId             Int?      @map("team_id")
  isActive           Boolean   @default(true) @map("is_active")
  isOnboarding       Boolean   @default(false) @map("is_onboarding")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  joinedAt           DateTime? @map("joined_at") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")

  role               Role                     @relation(fields: [roleId], references: [id])
  team               Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  leaderOf           Team[]                   @relation("TeamLeader")
  overrides          UserPermissionOverride[]
  auditLogs          AuditLog[]
  salesOrders        Order[]                  @relation("SalesOrders")
  orderStatusChanges OrderStatusHistory[]     @relation("StatusChanges")
  orderEditRequests  OrderEditRequest[]       @relation("EditRequests")
  assignedLeads      Lead[]                   @relation("AssignedLeads")
  leadDailyCounts    LeadDailyCount[]         @relation("LeadDailyCounts")
  targets            Target[]                 @relation("UserTargets")
  rewards            Reward[]                 @relation("UserRewards")
  attendance         Attendance[]             @relation("UserAttendance")
  leaveRequests      LeaveRequest[]           @relation("UserLeaves")

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id  Int    @id @default(autoincrement())
  key String @unique

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId       Int     @map("user_id")
  permissionId Int     @map("permission_id")
  allow        Boolean

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_overrides")
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  leaderUserId Int?     @map("leader_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  leader  User?    @relation("TeamLeader", fields: [leaderUserId], references: [id])
  members User[]   @relation("TeamMembers")
  orders  Order[]
  leads   Lead[]
  targets Target[] @relation("TeamTargets")

  @@map("teams")
}

// ============ LEADS (SPEC §3 / §14) ============

// SPEC §3.1 Source enum. Free-text campaign name lives separately (campaignName).
enum LeadSource {
  FACEBOOK_AD
  MESSENGER
  WHATSAPP
  INSTAGRAM
  REFERRAL
  REPEAT_CUSTOMER
  OTHER
}

// SPEC §3.1 funnel statuses. CONVERTED is set by the auto-convert hook when an
// order is created from the lead (§3.2); LOST requires a lostReason.
enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  NEGOTIATING
  CONVERTED
  LOST
}

// SPEC §3.1 — required when status = LOST; drives the lost-reason breakdown (R2).
enum LostReason {
  PRICE
  TRUST
  DELIVERY_TIME
  OUT_OF_AREA
  NO_RESPONSE
  OTHER
}

// A lead logged by an SE (SPEC §3.1). whatsapp_number is the dedupe key for the
// duplicate-phone check (§3.1). interested_in is a JSON array of
// {itemType:'PRODUCT'|'PACKAGE', id, name} snapshots. The lead↔order link is the
// single unique FK orders.lead_id (Order.lead below); Lead.convertedOrder is its
// back-relation, so a lead's converted order id is derived, never duplicated.
model Lead {
  id             Int         @id @default(autoincrement())
  leadDate       DateTime    @map("lead_date") @db.Date
  source         LeadSource
  campaignName   String?     @map("campaign_name")
  customerName   String?     @map("customer_name")
  country        String?
  whatsappNumber String      @map("whatsapp_number")
  interestedIn   Json?       @map("interested_in")
  status         LeadStatus  @default(NEW)
  followUpAt     DateTime?   @map("follow_up_at")
  lostReason     LostReason? @map("lost_reason")
  notes          String?
  assignedTo     Int         @map("assigned_to")
  teamId         Int?        @map("team_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdBy      Int?        @map("created_by")
  updatedBy      Int?        @map("updated_by")

  assignee       User   @relation("AssignedLeads", fields: [assignedTo], references: [id])
  team           Team?  @relation(fields: [teamId], references: [id])
  convertedOrder Order? @relation("LeadConversion")

  @@index([assignedTo, status])
  @@index([teamId, status])
  @@index([whatsappNumber])
  @@index([followUpAt])
  @@index([leadDate])
  @@map("leads")
}

// SPEC §3.1 bulk quick-entry — a daily lead count per SE/source/campaign, used
// for conversion-rate math when individual leads aren't logged. One row per
// (date, user, source, campaign) — the count is edited in place (upsert).
model LeadDailyCount {
  id           Int        @id @default(autoincrement())
  date         DateTime   @db.Date
  userId       Int        @map("user_id")
  source       LeadSource
  campaignName String?    @map("campaign_name")
  count        Int
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    Int?       @map("created_by")
  updatedBy    Int?       @map("updated_by")

  user User @relation("LeadDailyCounts", fields: [userId], references: [id])

  @@index([date])
  @@index([userId, date])
  @@map("lead_daily_counts")
}

// ============ CATALOG (SPEC §6.1 / §6.2 / §14) ============

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")

  products Product[]

  @@map("categories")
}

model Product {
  id                Int      @id @default(autoincrement())
  sku               String   @unique
  name              String
  categoryId        Int      @map("category_id")
  photoUrl          String?  @map("photo_url")
  unit              String   @default("pcs") // pcs | box | set
  avgCost           Decimal  @default(0) @map("avg_cost") @db.Decimal(12, 2) // weighted avg, recomputed on purchase (Phase 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(12, 2)
  priceFloor        Decimal  @default(0) @map("price_floor") @db.Decimal(12, 2)
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  isStockTracked    Boolean  @default(true) @map("is_stock_tracked") // false = perishable/per-order (cake, flowers)
  isActive          Boolean  @default(true) @map("is_active")
  // Caches — pure sums over stock_movements, written in the SAME transaction
  // as the movement rows (SPEC §14 integrity rule 2). stock_qty = physical
  // on-hand; reserved_qty = held by CONFIRMED orders; available = qty − reserved.
  stockQty          Int      @default(0) @map("stock_qty")
  reservedQty       Int      @default(0) @map("reserved_qty")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")

  category       Category        @relation(fields: [categoryId], references: [id])
  packageItems   PackageItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@map("products")
}

// ============ STOCK MOVEMENTS (SPEC §6.3 / §14) ============

enum StockMovementType {
  IN_PURCHASE
  OUT_SALE
  RESERVE
  RELEASE_RESERVE
  IN_RETURN
  ADJUST_PLUS
  ADJUST_MINUS
}

// Immutable ledger — rows are only ever inserted, never updated or deleted
// (corrections are new ADJUST rows). qty is SIGNED by effect on availability:
//   physical types (IN_PURCHASE +, OUT_SALE −, IN_RETURN +, ADJUST_PLUS +,
//   ADJUST_MINUS −) sum to products.stock_qty;
//   RESERVE (−) / RELEASE_RESERVE (+) sum to −products.reserved_qty.
// Therefore SUM(qty) over ALL rows = available-to-sell ("current stock =
// SUM(movements)", SPEC §14). All writes go through lib/stock.ts applyMovements.
model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  qty       Int
  refTable  String?           @map("ref_table") // "orders" | "purchases" | null (manual adjust)
  refId     Int?              @map("ref_id")
  reason    String?
  at        DateTime          @default(now())
  createdBy Int?              @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, at])
  @@index([refTable, refId])
  @@map("stock_movements")
}

// ============ PURCHASES (SPEC §6.3 / §14) ============

enum PurchasePaymentStatus {
  PAID
  DUE
  PARTIAL
}

model Purchase {
  id            Int                   @id @default(autoincrement())
  supplierName  String                @map("supplier_name")
  purchaseDate  DateTime              @map("purchase_date") @db.Date
  totalAmount   Decimal               @map("total_amount") @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(PAID) @map("payment_status")
  // When the outstanding balance is due (supplier credit, SPEC §6.3). Null when
  // fully paid at purchase. Amount paid = Σ linked "Product Purchase" expenses;
  // due = total_amount − paid, recognised as expense only when cash is paid.
  dueDate       DateTime?             @map("due_date") @db.Date
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  createdBy     Int?                  @map("created_by")
  updatedBy     Int?                  @map("updated_by")

  items PurchaseItem[]

  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int     @map("purchase_id")
  productId  Int     @map("product_id")
  qty        Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ============ EXPENSES (SPEC §9.1 / §14) ============
// Phase 2 scope: the model + the auto-created purchase expense (§6.3).
// The daily expense-entry UI arrives with the Accounting module.

enum CostType {
  FIXED
  VARIABLE
}

model ExpenseCategory {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  costType CostType @map("cost_type")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id           Int      @id @default(autoincrement())
  expenseDate  DateTime @map("expense_date") @db.Date
  categoryId   Int      @map("category_id")
  amount       Decimal  @db.Decimal(12, 2)
  walletId     Int?     @map("wallet_id") // paid-from account (SPEC §9.1 / §9.3)
  campaignName String?  @map("campaign_name")
  notes        String?
  receiptUrl   String?  @map("receipt_url")
  refTable     String?  @map("ref_table") // links auto-expenses: "purchases", "shipments", "rewards"
  refId        Int?     @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  wallet   Wallet?         @relation(fields: [walletId], references: [id])

  @@index([expenseDate])
  @@index([refTable, refId])
  @@index([walletId])
  @@map("expenses")
}

model Package {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  photoUrl     String?  @map("photo_url")
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  priceFloor   Decimal  @default(0) @map("price_floor") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  items      PackageItem[]
  orderItems OrderItem[]

  @@map("packages")
}

// The BOM. Editing it affects future orders only — order_items freeze
// unit_cost_snapshot at PACKED (SPEC §6.2 / integrity rule 4).
model PackageItem {
  id        Int @id @default(autoincrement())
  packageId Int @map("package_id")
  productId Int @map("product_id")
  qty       Int

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([packageId, productId])
  @@map("package_items")
}

// ============ CUSTOMERS & ORDERS (SPEC §4 / §14) ============

// SPEC §1.3 — LEAD/FOLLOW_UP exist in the lifecycle but orders are entered at
// CONFIRMED (§4.1 E); pre-order stages live in the Leads module (Phase 3).
enum OrderStatus {
  LEAD
  FOLLOW_UP
  CONFIRMED
  PACKED
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderItemType {
  PRODUCT
  PACKAGE
}

enum PaymentType {
  ADVANCE
  PARTIAL
  COD_COURIER
  POST_DELIVERY_MFS
  REFUND
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
  COURIER_COD
  OTHER
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// The probashi payer — phone_foreign is the repeat-customer lookup key (§4.1 A).
model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  phoneForeign String   @unique @map("phone_foreign")
  country      String
  fbLink       String?  @map("fb_link")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")

  orders Order[]

  @@map("customers")
}

model Order {
  id                    Int         @id @default(autoincrement())
  orderNo               String      @unique @map("order_no") // GV-YYMM-XXXX (§4.2)
  leadId                Int?        @unique @map("lead_id") // set on auto-convert from a lead (§3.2); 1:1 with Lead
  customerId            Int         @map("customer_id")
  recipientName         String      @map("recipient_name")
  recipientPhoneBd      String      @map("recipient_phone_bd") // number 2 of 2 (§1.2)
  recipientRelation     String?     @map("recipient_relation")
  deliveryAddress       String      @map("delivery_address")
  district              String
  thana                 String
  occasion              String?
  requestedDeliveryDate DateTime?   @map("requested_delivery_date") @db.Date
  subtotal              Decimal     @db.Decimal(12, 2)
  discount              Decimal     @default(0) @db.Decimal(12, 2)
  courierChargeCustomer Decimal     @default(0) @map("courier_charge_customer") @db.Decimal(12, 2)
  totalAmount           Decimal     @map("total_amount") @db.Decimal(12, 2) // subtotal − discount + courier (§4.1 C)
  advanceAmount         Decimal     @default(0) @map("advance_amount") @db.Decimal(12, 2) // initial advance at confirmation (snapshot)
  dueAmount             Decimal     @map("due_amount") @db.Decimal(12, 2) // recomputed on every payment write (integrity rule 1)
  codAmount             Decimal     @default(0) @map("cod_amount") @db.Decimal(12, 2)
  status                OrderStatus @default(CONFIRMED)
  cancelReason          String?     @map("cancel_reason")
  notes                 String?
  salesExecutiveId      Int         @map("sales_executive_id")
  teamId                Int?        @map("team_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  createdBy             Int?        @map("created_by")
  updatedBy             Int?        @map("updated_by")

  customer       Customer             @relation(fields: [customerId], references: [id])
  salesExecutive User                 @relation("SalesOrders", fields: [salesExecutiveId], references: [id])
  team           Team?                @relation(fields: [teamId], references: [id])
  lead           Lead?                @relation("LeadConversion", fields: [leadId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  editRequests   OrderEditRequest[]
  invoices       Invoice[]
  shipment       Shipment?

  // List queries filter by scope/status/window and sort by created_at desc —
  // composite indexes keep them fast as data accumulates (SPEC-scale: years).
  @@index([status, createdAt])
  @@index([salesExecutiveId, createdAt])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([recipientPhoneBd])
  @@map("orders")
}

model OrderItem {
  id               Int           @id @default(autoincrement())
  orderId          Int           @map("order_id")
  itemType         OrderItemType @map("item_type")
  productId        Int?          @map("product_id")
  packageId        Int?          @map("package_id")
  customName       String?       @map("custom_name") // ad-hoc package lines (§4.1 C)
  qty              Int
  unitPrice        Decimal       @map("unit_price") @db.Decimal(12, 2)
  unitCostSnapshot Decimal?      @map("unit_cost_snapshot") @db.Decimal(12, 2) // frozen at PACKED (integrity rule 4, Phase 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  @@map("order_items")
}

// Every status change timestamped → SLA reports (§4.2).
model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status") // null = order creation
  toStatus   OrderStatus  @map("to_status")
  byUser     Int          @map("by_user")
  at         DateTime     @default(now())
  note       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation("StatusChanges", fields: [byUser], references: [id])

  @@map("order_status_history")
}

// SPEC §8 / §14 — the company's receiving accounts (bKash/Nagad/Rocket agent
// numbers, bank accounts, cash box). Every payment records which wallet the
// money landed in; expenses record which wallet they were paid from. Per-wallet
// running balance = collections in − refunds/expenses out (SPEC §9.3). The
// account list is maintained by Admin/Accounts (SPEC §8).
enum WalletType {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
}

model Wallet {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  type      WalletType
  accountNo String?    @map("account_no")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  createdBy Int?       @map("created_by")
  updatedBy Int?       @map("updated_by")

  payments Payment[]
  expenses Expense[]

  @@map("wallets")
}

// SPEC §8 — multiple payments per order; transaction_id unique blocks
// double-entry of the same bKash/Nagad txn (integrity rule 3).
// REFUND amounts are stored positive and added back to due (integrity rule 1).
model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  paymentDate     DateTime      @default(now()) @map("payment_date")
  type            PaymentType
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  transactionId   String?       @unique @map("transaction_id")
  senderNumber    String?       @map("sender_number")
  screenshotUrl   String?       @map("screenshot_url")
  walletId        Int?          @map("wallet_id") // receiving account (SPEC §8); nullable so historic/unattributed COD rows stay valid
  isVerified      Boolean       @default(false) @map("is_verified") // Accounts verifies against the wallet statement (SPEC §8)
  verifiedBy      Int?          @map("verified_by")
  // Rejection (SPEC §8) — Accounts checked and the money never arrived (fake
  // txn / wrong amount). A rejected payment is excluded from due & collections,
  // so recording it never falsely settles an order. Mutually exclusive with
  // is_verified (enforced in the verify route).
  isRejected      Boolean       @default(false) @map("is_rejected")
  rejectionReason String?       @map("rejection_reason")
  rejectedBy      Int?          @map("rejected_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdBy       Int?          @map("created_by")
  updatedBy       Int?          @map("updated_by")

  order  Order   @relation(fields: [orderId], references: [id])
  wallet Wallet? @relation(fields: [walletId], references: [id])

  @@index([orderId])
  @@index([walletId])
  @@index([paymentDate])
  @@map("payments")
}

// SPEC §4.2 — after the edit window, SE edits go through TL/Manager approval.
// changes_json holds the proposed order payload; applied verbatim on approval.
model OrderEditRequest {
  id          Int               @id @default(autoincrement())
  orderId     Int               @map("order_id")
  requestedBy Int               @map("requested_by")
  changesJson Json              @map("changes_json")
  reason      String?
  status      EditRequestStatus @default(PENDING)
  reviewedBy  Int?              @map("reviewed_by")
  reviewedAt  DateTime?         @map("reviewed_at")
  reviewNote  String?           @map("review_note")
  createdAt   DateTime          @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester User  @relation("EditRequests", fields: [requestedBy], references: [id])

  @@index([status])
  @@map("order_edit_requests")
}

// SPEC §5 / §14 — one row per generated invoice PDF. An approved edit
// regenerates as version N+1; older versions and their files are kept.
// pdf_url is a path under storage/ (NOT public/) — invoices carry customer
// PII, so files are served only through the authenticated invoice API.
model Invoice {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  invoiceNo   String   @map("invoice_no") // = order_no (§5)
  version     Int
  pdfUrl      String   @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy Int?     @map("generated_by")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@map("invoices")
}

// ============ COURIER & DELIVERY (SPEC §7 / §14) ============

// A courier company (Steadfast, Pathao, RedX, Sundarban…). cod_fee_percent is
// the % the courier deducts when it remits collected COD — auto-recorded as an
// expense at reconciliation (SPEC §7 / §9.1). Per-district charges live in
// courier_zone_charges (drives the district-based courier charge on orders, §4.1 B).
model Courier {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  contact       String?
  codFeePercent Decimal  @default(0) @map("cod_fee_percent") @db.Decimal(5, 2)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     Int?     @map("created_by")
  updatedBy     Int?     @map("updated_by")

  zoneCharges CourierZoneCharge[]
  shipments   Shipment[]

  @@map("couriers")
}

// Per-district delivery charge for a courier (SPEC §7 / §14). Replaced as a set
// when a courier's zones are edited (like package BOM items).
model CourierZoneCharge {
  id        Int     @id @default(autoincrement())
  courierId Int     @map("courier_id")
  district  String
  charge    Decimal @db.Decimal(12, 2)

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([courierId, district])
  @@map("courier_zone_charges")
}

// SPEC §7 — the courier-stage statuses, mirroring the OrderStatus courier
// stages. A shipment's status drives the order's status (lib/courier.ts).
enum ShipmentStatus {
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// One shipment per order (SPEC §7). Created at courier handover (moves the order
// PACKED → HANDED_TO_COURIER); status updates sync the order status. COD flags
// track reconciliation (§7); return flags track the Admin-approved stock restore
// (§1.3). courier_cost_actual is the real amount paid to the courier incl. COD
// fee — a COST used by per-order P&L (§9.2), stripped from cost-blind roles.
model Shipment {
  id                    Int            @id @default(autoincrement())
  orderId               Int            @unique @map("order_id")
  courierId             Int            @map("courier_id")
  trackingNo            String?        @map("tracking_no")
  handoverDate          DateTime       @map("handover_date") @db.Date
  codAmount             Decimal        @default(0) @map("cod_amount") @db.Decimal(12, 2)
  expectedDelivery      DateTime?      @map("expected_delivery") @db.Date
  status                ShipmentStatus @default(HANDED_TO_COURIER)
  deliveredAt           DateTime?      @map("delivered_at")
  returnedAt            DateTime?      @map("returned_at")
  courierCostActual     Decimal?       @map("courier_cost_actual") @db.Decimal(12, 2)
  // COD reconciliation (§7): received flag + link to the auto-created fee expense.
  codReceived           Boolean        @default(false) @map("cod_received")
  codReceivedAt         DateTime?      @map("cod_received_at")
  codFeeExpenseId       Int?           @map("cod_fee_expense_id")
  // Return flow (§1.3): Admin approval gates the stock restore + return charge.
  returnApproved        Boolean        @default(false) @map("return_approved")
  returnApprovedAt      DateTime?      @map("return_approved_at")
  returnApprovedBy      Int?           @map("return_approved_by")
  returnCharge          Decimal?       @map("return_charge") @db.Decimal(12, 2)
  returnChargeExpenseId Int?           @map("return_charge_expense_id")
  // Steadfast API integration (STEADFAST_INTEGRATION.md §4). All nullable/default
  // so manual (non-API) shipments are unaffected. consignment_id is the Steadfast
  // side id used to correlate webhook/poll updates back to this shipment;
  // steadfast_status is the raw courier status (audit); on_hold / needs_attention
  // are operator flags surfaced in the courier report; last_polled_at gates the
  // polling fallback (§3B).
  consignmentId         BigInt?        @unique @map("consignment_id")
  steadfastStatus       String?        @map("steadfast_status")
  onHold                Boolean        @default(false) @map("on_hold")
  needsAttention        Boolean        @default(false) @map("needs_attention")
  lastPolledAt          DateTime?      @map("last_polled_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  createdBy             Int?           @map("created_by")
  updatedBy             Int?           @map("updated_by")

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        Courier                 @relation(fields: [courierId], references: [id])
  statusLogs     ShipmentStatusLog[]
  trackingEvents ShipmentTrackingEvent[]

  @@index([status])
  @@index([courierId])
  @@map("shipments")
}

// ============ STEADFAST COURIER INTEGRATION (STEADFAST_INTEGRATION.md §4) ============

// Where a raw status update came from: the real-time webhook (primary) or the
// polling fallback (§3A / §3B). Both go through the SAME status-update code path.
enum StatusLogSource {
  WEBHOOK
  POLL
}

// Immutable audit trail of every raw status payload Steadfast sends us, via
// webhook or poll (§3A step 4 / §3B step 4). shipment_id is nullable so a
// payload for an unknown consignment is still logged (§3A step 1).
model ShipmentStatusLog {
  id         Int             @id @default(autoincrement())
  shipmentId Int?            @map("shipment_id")
  rawPayload Json            @map("raw_payload")
  rawStatus  String?         @map("raw_status")
  source     StatusLogSource
  receivedAt DateTime        @default(now()) @map("received_at")

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@map("shipment_status_logs")
}

// Non-status tracking messages (§3A payload 2, notification_type=tracking_update)
// rendered as a timeline on the order/shipment detail page.
model ShipmentTrackingEvent {
  id         Int      @id @default(autoincrement())
  shipmentId Int      @map("shipment_id")
  message    String
  eventAt    DateTime @map("event_at")
  source     String // "WEBHOOK" | "POLL"
  createdAt  DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_tracking_events")
}

// One integration currently: Steadfast. Keys are encrypted at rest (lib/crypto.ts)
// and only ever used server-side (§5). webhook_token_encrypted authenticates
// inbound webhooks (Bearer). Timestamps give the Settings page health visibility.
enum CourierIntegrationType {
  STEADFAST
}

model CourierIntegration {
  id                    Int                    @id @default(autoincrement())
  courier               CourierIntegrationType @unique
  apiKeyEncrypted       String?                @map("api_key_encrypted")
  secretKeyEncrypted    String?                @map("secret_key_encrypted")
  webhookTokenEncrypted String?                @map("webhook_token_encrypted")
  isEnabled             Boolean                @default(false) @map("is_enabled")
  pollingMinutes        Int                    @default(60) @map("polling_minutes")
  connectedAt           DateTime?              @map("connected_at")
  lastSyncAt            DateTime?              @map("last_sync_at")
  lastWebhookAt         DateTime?              @map("last_webhook_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("courier_integrations")
}

// SPEC §14 — key/value settings (edit-window minutes, packaging cost, …).
model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  at         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============ TARGETS & REWARDS (SPEC §10 / §14) ============

// A monthly target is set for either a single user (SE/TL) or a whole team.
enum TargetScope {
  USER
  TEAM
}

// SPEC §10 — target order count and/or sales value (৳), per SE and per Team, per
// month. `month` is the first day of the calendar month (Asia/Dhaka). Either
// targetOrders or targetAmount (or both) may be set. `isConfidential` marks a
// user's own target (a TL's) as visible to Admin + that user only (§10).
model Target {
  id             Int         @id @default(autoincrement())
  month          DateTime    @db.Date
  scope          TargetScope
  userId         Int?        @map("user_id")
  teamId         Int?        @map("team_id")
  targetOrders   Int?        @map("target_orders")
  targetAmount   Decimal?    @map("target_amount") @db.Decimal(12, 2)
  isConfidential Boolean     @default(false) @map("is_confidential")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdBy      Int?        @map("created_by")
  updatedBy      Int?        @map("updated_by")

  user User? @relation("UserTargets", fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation("TeamTargets", fields: [teamId], references: [id], onDelete: Cascade)

  // One target per subject per month. userId/teamId are mutually exclusive by
  // scope; Postgres treats NULLs as distinct so the null side never collides —
  // (month,userId) guards USER rows, (month,teamId) guards TEAM rows.
  @@unique([month, userId])
  @@unique([month, teamId])
  @@index([month])
  @@map("targets")
}

// SPEC §10 — reward rule table. ACHIEVEMENT rules pay when a user's monthly
// achievement % (against their target) reaches minAchievementPercent (e.g.
// 100% → ৳3,000, 120% → ৳6,000). TOP_SELLER rules pay the month's top seller(s)
// by sales value.
enum RewardRuleType {
  ACHIEVEMENT
  TOP_SELLER
}

model RewardRule {
  id                    Int            @id @default(autoincrement())
  name                  String         @unique
  type                  RewardRuleType @default(ACHIEVEMENT)
  minAchievementPercent Decimal?       @map("min_achievement_percent") @db.Decimal(6, 2)
  rewardAmount          Decimal        @map("reward_amount") @db.Decimal(12, 2)
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  createdBy             Int?           @map("created_by")
  updatedBy             Int?           @map("updated_by")

  rewards Reward[]

  @@map("reward_rules")
}

// SPEC §10 — a computed reward for a user/month/rule. Month-close computation
// creates PENDING rows; Admin approval flips to APPROVED and books the expense
// (category "Reward/Bonus", ref → this row); PAID marks it disbursed. The set of
// a user's rewards over months is their profile reward history.
enum RewardStatus {
  PENDING
  APPROVED
  PAID
}

model Reward {
  id                 Int          @id @default(autoincrement())
  userId             Int          @map("user_id")
  month              DateTime     @db.Date
  ruleId             Int          @map("rule_id")
  amount             Decimal      @db.Decimal(12, 2)
  achievementPercent Decimal?     @map("achievement_percent") @db.Decimal(6, 2)
  status             RewardStatus @default(PENDING)
  approvedBy         Int?         @map("approved_by")
  approvedAt         DateTime?    @map("approved_at")
  expenseId          Int?         @unique @map("expense_id") // set when APPROVED books the expense
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  createdBy          Int?         @map("created_by")
  updatedBy          Int?         @map("updated_by")

  user User       @relation("UserRewards", fields: [userId], references: [id])
  rule RewardRule @relation(fields: [ruleId], references: [id])

  // Idempotent recompute: at most one reward per user, month and rule.
  @@unique([userId, month, ruleId])
  @@index([month])
  @@index([userId])
  @@map("rewards")
}

// ============ ATTENDANCE & LEAVE (SPEC §11 / §14) ============

// SPEC §11 — a day's attendance for one employee. LATE / HALF_DAY are auto-set
// from the check-in time against the office-hours settings; PRESENT is on time.
// ABSENT is never stored — it is derived in reports for a workday with no row
// and no approved leave (so no nightly job is needed). LEAVE marks a day the
// employee is out on an approved leave.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  LEAVE
}

// SPEC §11 — one row per employee per calendar day (Asia/Dhaka). `date` is that
// day stored as UTC-midnight so the @db.Date column reads back the same calendar
// day (mirrors the reward/expense date convention). Timestamps are server-side.
model Attendance {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  date       DateTime         @db.Date
  checkInAt  DateTime?        @map("check_in_at")
  checkOutAt DateTime?        @map("check_out_at")
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  createdBy  Int?             @map("created_by")
  updatedBy  Int?             @map("updated_by")

  user User @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)

  // One attendance row per user per day.
  @@unique([userId, date])
  @@index([date])
  @@map("attendance")
}

// SPEC §11 — simple leave request + approval flow. PENDING until a manager
// (attendance.view_all) approves or rejects. An APPROVED request marks its
// [fromDate, toDate] span as LEAVE in the monthly sheet.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  fromDate   DateTime    @map("from_date") @db.Date
  toDate     DateTime    @map("to_date") @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy Int?        @map("approved_by")
  approvedAt DateTime?   @map("approved_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  createdBy  Int?        @map("created_by")
  updatedBy  Int?        @map("updated_by")

  user User @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}
